load("@bazel_lib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "fortran_toolchain.bzl",
    "fortran_toolchain_info.bzl",
])

bzl_library(
    name = "fortran_toolchain",
    srcs = ["fortran_toolchain.bzl"],
    # keep: rules_cc groups its public CcInfo and cc_common loads.
    deps = [
        ":fortran_toolchain_info",
        "@rules_cc//cc/common",
    ],
)

bzl_library(
    name = "fortran_toolchain_info",
    srcs = ["fortran_toolchain_info.bzl"],
)
