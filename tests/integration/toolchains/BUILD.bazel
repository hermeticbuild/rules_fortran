load("@rules_fortran//fortran/toolchains:fortran_toolchain.bzl", "fortran_toolchain")

fortran_toolchain(
    name = "flang",
    compiler = "@llvm//tools:flang",
    compiler_kind = "flang",
    intrinsic_modules = "@llvm//runtimes/flang:intrinsic_modules",
    runtime = "@llvm//runtimes/flang:runtime",
    target_flags = select({
        "@llvm//platforms/config:linux_aarch64_musl": ["--target=aarch64-linux-musl"],
        "@llvm//platforms/config:linux_x86_64_musl": ["--target=x86_64-linux-musl"],
    }),
)

[
    toolchain(
        name = "flang_{}_{}_to_linux_{}_musl".format(os, cpu, target_cpu),
        exec_compatible_with = [
            "@platforms//os:" + os,
            "@platforms//cpu:" + cpu,
        ],
        target_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:" + target_cpu,
            "@llvm//constraints/libc:musl",
        ],
        toolchain = ":flang",
        toolchain_type = "@rules_fortran//fortran:toolchain_type",
    )
    for os in [
        "linux",
        "macos",
        "windows",
    ]
    for cpu in [
        "x86_64",
        "aarch64",
    ]
    for target_cpu in [
        "x86_64",
        "aarch64",
    ]
]
