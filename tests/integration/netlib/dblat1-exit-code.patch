Carry DBLAT1 numerical failures through to the process exit status.

From https://github.com/google-ml-infra/rules_ml_toolchain/blob/e5c395b948974af5fc7498fe93e7a6807ba4f7d5/third_party/rules_fortran/examples/blas/blat1-nrm2-inf-and-exit-code.patch

diff --git a/TESTING/dblat1.f b/TESTING/dblat1.f
index 95da39d..a69b673 100644
--- a/TESTING/dblat1.f
+++ b/TESTING/dblat1.f
@@ -50,6 +50,7 @@
 *     .. Local Scalars ..
       DOUBLE PRECISION SFAC
       INTEGER          IC
+      LOGICAL          FATAL
 *     .. External Subroutines ..
       EXTERNAL         CHECK0, CHECK1, CHECK2, CHECK3, HEADER
 *     .. Common blocks ..
@@ -58,6 +59,7 @@
       DATA             SFAC/9.765625D-4/
 *     .. Executable Statements ..
       WRITE (NOUT,99999)
+      FATAL = .FALSE.
       DO 20 IC = 1, 13
          ICASE = IC
          CALL HEADER
@@ -82,8 +84,13 @@
             CALL CHECK3(SFAC)
          END IF
 *        -- Print
-         IF (PASS) WRITE (NOUT,99998)
+         IF (PASS) THEN
+            WRITE (NOUT,99998)
+         ELSE
+            FATAL = .TRUE.
+         END IF
    20 CONTINUE
+      IF (FATAL) STOP 1
       STOP
 *
 99999 FORMAT (' Real BLAS Test Program Results',/1X)
@@ -1153,6 +1160,10 @@
 *     .. Scalar Arguments ..
       INTEGER           INCX, N
       DOUBLE PRECISION  THRESH
+*     .. Scalars in Common ..
+      INTEGER           ICASEC, INCXC, INCYC, NC
+      LOGICAL           PASS
+      COMMON            /COMBLA/ICASEC, NC, INCXC, INCYC, PASS
 *
 *  =====================================================================
 *     .. Parameters ..
@@ -1307,6 +1318,7 @@
                TRAT = (ABS(SNRM-ZNRM) / ZNRM) / (DBLE(N)*ULP)
             END IF
             IF ((TRAT.NE.TRAT).OR.(TRAT.GE.THRESH)) THEN
+               PASS = .FALSE.
                IF (FIRST) THEN
                   FIRST = .FALSE.
                   WRITE(NOUT,99999)
